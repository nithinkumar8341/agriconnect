# Copy to .env and adjust. Never commit .env.
# Validated at startup by src/config/env.js; the server refuses to start if anything is invalid.

# development | test | production
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/agriconnect?replicaSet=rs0

# Comma-separated browser origins allowed to call the API with cookies. Required in production.
CORS_ORIGINS=http://localhost:5173

# Optional. Defaults: info (silent when NODE_ENV=test).
# LOG_LEVEL=info

# Maximum JSON request body size.
JSON_BODY_LIMIT=100kb

# Global per-IP rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Number of reverse proxies in front of the app. Set to 1 on Render so client IPs are correct.
TRUST_PROXY=0

# --- Authentication ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Both are required, at least 32 characters, and must differ from each other.
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-jwt-signing
OTP_HMAC_SECRET=replace-with-a-different-long-random-string-for-otps
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# strict | lax | none. Strict works because the frontend calls the API same-origin.
COOKIE_SAMESITE=strict

# --- SMS ---
# console (development only: prints the SMS to the terminal) | msg91 (not implemented yet)
SMS_PROVIDER=console
# MSG91_AUTH_KEY=

# Development only: every OTP becomes this code. Rejected when NODE_ENV=production.
DEV_FIXED_OTP=123456
