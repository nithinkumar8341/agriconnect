# Copy to .env and adjust. Never commit .env.
PORT=8000
LOG_LEVEL=info
# Optional: without it the chatbot and review insights use rule-based fallbacks.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Shared secret; the backend sends it as X-Internal-Key. Set the same value in backend/.env.
AI_INTERNAL_KEY=
